{
  "manifest_version": 3,
  "name": "Zunbreak Research Inbox",
  "version": "1.0.0",
  "description": "Save the current Brave tab to your local research inbox.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Zunbreak Inbox"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
