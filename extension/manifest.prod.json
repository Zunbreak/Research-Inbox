{
  "manifest_version": 3,
  "name": "Zunbreak Research Inbox",
  "version": "1.1.0",
  "description": "Save pages to your local research inbox — no dev server required.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Zunbreak Inbox"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
